generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id             String               @id @default(uuid())
  authUserId     String               @unique @db.Uuid
  nombre         String
  email          String               @unique
  rol            Rol                  @default(USER)
  estado         Estado               @default(ACTIVO)
  fechaRegistro  DateTime             @default(now())
  descargas      Descarga[]
  solicitudes    SolicitudPartitura[]
  notificaciones Notificacion[]
  suscripciones  Suscripcion[]
  pagos          Pago[]
}

model Cancion {
  id                 String               @id @default(uuid()) @db.Uuid
  titulo             String
  compositor         String?
  descripcion        String?
  genero             String?
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @default(now()) @updatedAt
  partituras         Partitura[]
  solicitudes        SolicitudPartitura[]

  @@index([titulo])
  @@index([compositor])
  @@index([genero])
}

model Partitura {
  id                 String               @id @default(uuid())
  instrumento        String
  nivel              NivelPartitura       @default(INTERMEDIO)
  tonalidad          String
  precioIndividual   Decimal              @default(1.99) @db.Decimal(10, 2)
  portadaUrl         String?
  archivoPdf         String?
  archivoMidi        String?
  archivoMusicXml    String?
  publicada          Boolean              @default(true)
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @updatedAt
  cancionId          String               @db.Uuid
  descargas          Descarga[]
  cancion            Cancion              @relation(fields: [cancionId], references: [id], onDelete: Cascade)
  solicitudes        SolicitudPartitura[]
  pagos              Pago[]

  @@index([cancionId])
  @@index([instrumento])
  @@index([publicada])
}

model Descarga {
  id          String    @id @default(uuid())
  usuarioId   String
  partituraId String
  fecha       DateTime  @default(now())
  partitura   Partitura @relation(fields: [partituraId], references: [id], onDelete: Cascade)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([partituraId])
  @@index([fecha])
}

model SolicitudPartitura {
  id                  String          @id @default(uuid())
  usuarioId           String
  partituraId         String?
  titulo              String
  compositor          String?
  instrumento         String?
  descripcion         String?
  comentarios         String?
  estado              EstadoSolicitud @default(PENDIENTE)
  fechaSolicitud      DateTime        @default(now())
  fechaActualizacion  DateTime        @updatedAt
  cancionId           String          @db.Uuid
  tonalidadSolicitada String?
  cancion             Cancion         @relation(fields: [cancionId], references: [id], onDelete: Cascade)
  partitura           Partitura?      @relation(fields: [partituraId], references: [id])
  usuario             Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  notificaciones      Notificacion[]

  @@index([usuarioId])
  @@index([cancionId])
  @@index([partituraId])
  @@index([estado])
  @@index([fechaSolicitud])
}

model Notificacion {
  id            String             @id @default(uuid())
  usuarioId     String
  solicitudId   String
  titulo        String
  mensaje       String
  leida         Boolean            @default(false)
  fechaCreacion DateTime           @default(now())
  usuario       Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  solicitud     SolicitudPartitura @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida])
  @@index([solicitudId])
  @@index([fechaCreacion])
}

model Plan {
  id                 String        @id @default(uuid())
  nombre             String
  descripcion        String?
  precio             Decimal       @db.Decimal(10, 2)
  moneda             String        @default("USD")
  intervalo          IntervaloPlan
  limiteDescargas    Int
  activo             Boolean       @default(true)
  stripePriceId      String?       @unique
  fechaCreacion      DateTime      @default(now())
  fechaActualizacion DateTime      @updatedAt
  suscripciones      Suscripcion[]

  @@index([activo])
  @@index([intervalo])
}

model Suscripcion {
  id                   String            @id @default(uuid())
  usuarioId            String
  planId               String
  estado               EstadoSuscripcion @default(ACTIVA)
  fechaInicio          DateTime
  fechaFin             DateTime
  descargasUsadas      Int               @default(0)
  stripeSubscriptionId String?           @unique
  usuario              Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plan                 Plan              @relation(fields: [planId], references: [id])
  pagos                Pago[]
  fechaCreacion        DateTime          @default(now())
  fechaActualizacion   DateTime          @updatedAt

  @@index([usuarioId, estado])
  @@index([planId])
  @@index([fechaFin])
}

model Pago {
  id                    String       @id @default(uuid())
  usuarioId             String
  suscripcionId         String?
  partituraId           String?
  tipo                  TipoPago
  estado                EstadoPago   @default(PENDIENTE)
  monto                 Decimal      @db.Decimal(10, 2)
  moneda                String       @default("USD")
  stripePaymentIntentId String?      @unique
  stripeCheckoutId      String?      @unique
  fechaCreacion         DateTime     @default(now())
  usuario               Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  suscripcion           Suscripcion? @relation(fields: [suscripcionId], references: [id])
  partitura             Partitura?   @relation(fields: [partituraId], references: [id])

  @@index([usuarioId, estado])
  @@index([suscripcionId])
  @@index([partituraId])
  @@index([fechaCreacion])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Partitura_backup {
  id                 String?
  titulo             String?
  compositor         String?
  descripcion        String?
  instrumento        String?
  genero             String?
  nivel              NivelPartitura?
  tonalidad          String?
  portadaUrl         String?
  archivoPdf         String?
  archivoMidi        String?
  archivoMusicXml    String?
  publicada          Boolean?
  fechaCreacion      DateTime?
  fechaActualizacion DateTime?
  cancionId          String?         @db.Uuid

  @@ignore
}

enum Rol {
  USER
  ADMIN
}

enum Estado {
  ACTIVO
  INACTIVO
}

enum NivelPartitura {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum EstadoSolicitud {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  RECHAZADA
}

enum IntervaloPlan {
  MENSUAL
  ANUAL
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  VENCIDA
  PAGO_FALLIDO
}

enum TipoPago {
  SUSCRIPCION
  DESCARGA_INDIVIDUAL
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}
